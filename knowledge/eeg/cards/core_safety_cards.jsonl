{"schema_version":"eeg_knowledge_card_v2","card_id":"CARD.ICTAL.DEFINITE_EVOLUTION.ACNS2021","concept_id":"ICTAL.DEFINITE_EVOLUTION","claim_type":"criterion","preferred_terms":{"en":"definite evolution","zh":"明确演变"},"aliases":[],"namespace":"ICTAL","semantic_layer":"PAT","statement_zh":"在ACNS 2021危重症术语范围内，明确演变要求在同一变化类别（频率、形态或位置）内至少两次明确的连续顺序变化，并满足每个被计入阶段的周期数、频率步长及连续不变时间等操作条件；单纯振幅变化不足。","applicability":{"settings":["critical_care_acns_2021","other_settings_only_with_explicit_attribution"],"population":["non_neonatal_unless_profile_validated"],"requires":["continuous_time_series","at_least_three_cycles_per_frequency_morphology_or_location_stage","profile_id"]},"logic":{"required":["at_least_two_sequential_changes_within_the_same_frequency_morphology_or_location_category","frequency_change_each_at_least_0_5_Hz_in_same_direction_or_two_morphology_changes_or_location_spread","no_unchanged_interval_of_five_or_more_minutes"],"supporting":["background_disruption","spatial_recruitment"],"exclusions":["amplitude_change_only","mixed_single_changes_across_categories","two_disconnected_snapshots","insufficient_cycles"],"differentials":["fluctuation","artifact","state_change"]},"allowed_inferences":["supports_an_evolving_EEG_pattern_when_duration_and_other_criteria_are_separately_met"],"forbidden_inferences":["one_change_equals_definite_evolution","mixed_single_changes_across_categories_equal_definite_evolution","definite_evolution_without_required_duration_equals_electrographic_seizure","definite_evolution_alone_localizes_clinical_soz"],"report_language":{"preferred":["按已声明的ACNS 2021操作条件，该模式满足/不满足明确演变；是否达到电图发作还需单独核验持续时间和发作判据。"],"prohibited":["有一点变化，所以是明确演变。"]},"source_refs":[{"source_id":"acns-2021-evolution","locator":null,"support_type":"paraphrase","verification_status":"locator_pending"}],"review":{"status":"draft_clinical_review_required","reviewers":[],"reviewed_at":null}}
{"schema_version":"eeg_knowledge_card_v2","card_id":"CARD.RPP.IIC.ACNS2021_BOUNDARY","concept_id":"RPP.IIC","claim_type":"safety_boundary","preferred_terms":{"en":"ictal-interictal continuum","zh":"发作—发作间期连续体"},"aliases":["IIC"],"namespace":"RPP","semantic_layer":"PAT","statement_zh":"ACNS 2021的IIC是危重症EEG操作框架而非诊断；其模式不应已满足电图发作（ESz）或电图癫痫持续状态（ESE），且只有满足规定频率、持续时间以及plus修饰或波动条件的PD/SW或偏侧RDA才可进入该框架；GRDA不属于IIC。","applicability":{"settings":["critical_care_acns_2021"],"population":["non_neonatal_unless_profile_validated"],"requires":["pattern_family","frequency","duration","plus_or_fluctuation_status"]},"logic":{"required":["pattern_does_not_already_qualify_as_electrographic_seizure_or_electrographic_status_epilepticus","one_registered_ACNS_2021_IIC_path"],"supporting":["clinical_context"],"exclusions":["electrographic_seizure","electrographic_status_epilepticus","GRDA","duration_below_required_path","missing_frequency"],"differentials":["electrographic_seizure","electrographic_status_epilepticus","interictal_RPP","artifact"]},"allowed_inferences":["pattern_meets_an_ACNS_2021_IIC_operational_path"],"forbidden_inferences":["IIC_is_a_clinical_diagnosis","possible_iic_or_definite_iic_presented_as_ACNS_categories","GRDA_is_IIC","electroclinical_seizure_substituted_for_ACNS_ESE_exclusion"],"report_language":{"preferred":["该模式满足ACNS 2021 IIC的{criterion_path}操作条件；IIC本身不是诊断。"],"prohibited":["属于明确IIC，因此已证实发作。"]},"source_refs":[{"source_id":"acns-2021-rpp-boundary","locator":null,"support_type":"paraphrase","verification_status":"locator_pending"}],"review":{"status":"draft_clinical_review_required","reviewers":[],"reviewed_at":null}}
