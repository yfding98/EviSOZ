{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_schema_registry_v1.schema.json",
  "title": "EviSOZ content-addressed schema/validator registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "entries", "registry_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_schema_registry_v1"},
    "registry_id": {
      "type": "string",
      "pattern": "^EVISOZ-SCHEMAS-[0-9a-f]{24}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "registry_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound_schema_version",
        "schema_id",
        "schema_path",
        "schema_artifact_ref",
        "validator"
      ],
      "properties": {
        "bound_schema_version": {"type": "string", "minLength": 1},
        "schema_id": {"type": "string", "minLength": 1},
        "schema_path": {"type": "string", "minLength": 1},
        "schema_artifact_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validator_id",
            "implementation_version",
            "module",
            "callable",
            "implementation_path",
            "implementation_artifact_ref"
          ],
          "properties": {
            "validator_id": {"type": "string", "minLength": 1},
            "implementation_version": {"type": "string", "minLength": 1},
            "module": {"type": "string", "minLength": 1},
            "callable": {"type": "string", "minLength": 1},
            "implementation_path": {"type": "string", "minLength": 1},
            "implementation_artifact_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"}
          }
        }
      }
    }
  }
}
