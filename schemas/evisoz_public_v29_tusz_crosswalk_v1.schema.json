{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_public_v29_tusz_crosswalk_v1.schema.json",
  "title": "Privacy-safe public canonical-v29 to TUSZ patient crosswalk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "crosswalk_id",
    "status",
    "identity_hash_domain",
    "local_identity_hash_domain",
    "v29_roster_ref",
    "identity_crosswalk_ref",
    "rows",
    "counts",
    "permissions",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_public_v29_tusz_crosswalk_v1"},
    "crosswalk_id": {"type": "string", "pattern": "^EVISOZ-XWALK-[0-9a-f]{24}$"},
    "status": {"enum": ["complete_audit_only_training_disabled", "incomplete_audit_only_training_disabled"]},
    "identity_hash_domain": {"const": "evisoz-public-v29-tusz-patient-v1"},
    "local_identity_hash_domain": {"const": "evisoz-public-v29-tusz-local-patient-v1"},
    "v29_roster_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "identity_crosswalk_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v29_patient_count", "matched_patient_count", "unmatched_patient_count", "ambiguous_patient_count", "mapped_record_count"],
      "properties": {
        "v29_patient_count": {"type": "integer", "minimum": 1},
        "matched_patient_count": {"type": "integer", "minimum": 0},
        "unmatched_patient_count": {"type": "integer", "minimum": 0},
        "ambiguous_patient_count": {"type": "integer", "minimum": 0},
        "mapped_record_count": {"type": "integer", "minimum": 0}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crosswalk_for_leakage_audit", "crosswalk_for_split_assignment", "training_authorized", "task_label_training_authorized", "raw_patient_identifiers_stored", "can_create_patient_fact"],
      "properties": {
        "crosswalk_for_leakage_audit": {"const": true},
        "crosswalk_for_split_assignment": {"const": false},
        "training_authorized": {"const": false},
        "task_label_training_authorized": {"const": false},
        "raw_patient_identifiers_stored": {"const": false},
        "can_create_patient_fact": {"const": false}
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crosswalk_row_id",
        "v29_identity_namespace",
        "v29_identity_sha256",
        "tusz_identity_namespace",
        "tusz_identity_sha256",
        "tusz_local_patient_identity_sha256",
        "official_splits",
        "mapped_record_count",
        "unique_container_count",
        "record_roster_sha256",
        "mapping_status",
        "identity_match_method",
        "raw_patient_identifiers_stored"
      ],
      "properties": {
        "crosswalk_row_id": {"type": "string", "pattern": "^EVISOZ-XWALK-ROW-[0-9a-f]{24}$"},
        "v29_identity_namespace": {"type": "string", "minLength": 1},
        "v29_identity_sha256": {"$ref": "#/$defs/sha256"},
        "tusz_identity_namespace": {"const": "deepsoz_tusz_identity_v2"},
        "tusz_identity_sha256": {"$ref": "#/$defs/sha256"},
        "tusz_local_patient_identity_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "official_splits": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mapped_record_count": {"type": "integer", "minimum": 0},
        "unique_container_count": {"type": "integer", "minimum": 0},
        "record_roster_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_status": {"enum": ["unique", "unmatched", "ambiguous_or_unmapped", "ambiguous_local_patient"]},
        "identity_match_method": {"const": "exact_numeric_patient_id_via_identity_v2"},
        "raw_patient_identifiers_stored": {"const": false}
      }
    }
  }
}
