{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_split_roster_v1.schema.json",
  "title": "EviSOZ patient-level split roster v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roster_id",
    "assignments",
    "patient_level_isolation",
    "synthetic_text_inherits_patient_split",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_split_roster_v1"},
    "roster_id": {"type": "string", "pattern": "^EVISOZ-SPLIT-[0-9a-f]{24}$"},
    "assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assignment"}},
    "patient_level_isolation": {"const": true},
    "synthetic_text_inherits_patient_split": {"const": true},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "officialSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "official_split"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "official_split": {"type": ["string", "null"]}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkage_group_id",
        "linkage_group_ref",
        "official_splits",
        "evisoz_role",
        "outer_holdout_fold",
        "locked"
      ],
      "properties": {
        "linkage_group_id": {"type": "string", "minLength": 1},
        "linkage_group_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "official_splits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/officialSplit"}},
        "evisoz_role": {"enum": ["development_cv", "locked_test", "external_evaluation"]},
        "outer_holdout_fold": {"type": ["integer", "null"], "minimum": 0},
        "locked": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"evisoz_role": {"const": "development_cv"}},
            "required": ["evisoz_role"]
          },
          "then": {
            "properties": {
              "outer_holdout_fold": {"type": "integer", "minimum": 0},
              "locked": {"const": false},
              "official_splits": {
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/officialSplit"},
                    {
                      "properties": {
                        "official_split": {
                          "anyOf": [
                            {"type": "null"},
                            {
                              "type": "string",
                              "not": {
                                "pattern": "(^|[._:-])([Tt][Ee][Ss][Tt]([Ii][Nn][Gg])?|[Ee][Vv][Aa][Ll]([Uu][Aa][Tt][Ii][Oo][Nn])?|[Hh][Ee][Ll][Dd][-_]?[Oo][Uu][Tt]|[Hh][Oo][Ll][Dd][-_]?[Oo][Uu][Tt]|[Ee][Xx][Tt][Ee][Rr][Nn][Aa][Ll])($|[._:-])"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "outer_holdout_fold": {"type": "null"},
              "locked": {"const": true}
            }
          }
        }
      ]
    }
  }
}
