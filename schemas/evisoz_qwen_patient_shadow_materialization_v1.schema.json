{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_qwen_patient_shadow_materialization_v1.schema.json",
  "title": "EviSOZ patient-level Qwen shadow packet materialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "materialization_id", "status", "source_refs", "rows",
    "counts", "runtime_policy", "permissions", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_qwen_patient_shadow_materialization_v1"},
    "materialization_id": {"type": "string", "pattern": "^EVISOZ-QPATIENT-MAT-[0-9a-f]{24}$"},
    "status": {"const": "real_loader_patient_shadow_materialized"},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loader_receipt", "shadow_evaluation"],
      "properties": {
        "loader_receipt": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "shadow_evaluation": {"$ref": "evisoz_artifact_ref_v1.schema.json"}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "linkage_group_id", "event_ids", "evisoz_role", "outer_holdout_fold",
          "qwen_patient_input_ref", "relative_path"
        ],
        "properties": {
          "linkage_group_id": {"type": "string", "pattern": "^EVISOZ-PAT-[0-9a-f]{24}$"},
          "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evisoz_role": {"enum": ["development_cv", "locked_test"]},
          "outer_holdout_fold": {"type": ["integer", "null"], "minimum": 0},
          "qwen_patient_input_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
          "relative_path": {"type": "string", "pattern": "^patients/EVISOZ-PAT-[0-9a-f]{24}/qwen_patient_input\\.json$"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count", "patient_count", "packet_count",
        "development_patient_count", "locked_test_patient_count"
      ],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "patient_count": {"type": "integer", "minimum": 1},
        "packet_count": {"type": "integer", "minimum": 1},
        "development_patient_count": {"type": "integer", "minimum": 0},
        "locked_test_patient_count": {"type": "integer", "minimum": 0}
      }
    },
    "runtime_policy": {
      "const": {
        "physician_report_text_opened": false,
        "canonical_shadow_report_opened": true,
        "teacher_runtime_opened": false,
        "training_allowed": false,
        "prompt_or_rag_allowed": false,
        "patient_fact_created": false,
        "candidate_only": true
      }
    },
    "permissions": {
      "const": {
        "qwen_generation_allowed": false,
        "patient_fact_creation_allowed": false,
        "embeddings_materialized": false,
        "requires_physician_review": true
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
