{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_private_physician_report_inventory_v1.schema.json",
  "title": "Privacy-safe private physician-report inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "source_bindings",
    "association_policy",
    "reports",
    "counts",
    "manual_mapping_required_report_ids",
    "privacy_and_use_contract",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_private_physician_report_inventory_v1"},
    "inventory_id": {"type": "string", "pattern": "^EVISOZ-REPORTS-[0-9a-f]{24}$"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "association_policy": {"$ref": "#/$defs/associationPolicy"},
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/report"}
    },
    "counts": {"type": "object"},
    "manual_mapping_required_report_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVISOZ-PRPT-[0-9a-f]{24}$"}
    },
    "privacy_and_use_contract": {"type": "object"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_source_manifest_ref",
        "frozen_signal_roster_ref",
        "split_roster_ref",
        "patient_count",
        "report_document_set_sha256"
      ],
      "properties": {
        "private_source_manifest_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "frozen_signal_roster_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "split_roster_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "patient_count": {"type": "integer", "minimum": 1},
        "report_document_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "associationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "filename_route",
        "body_fallback_route",
        "fuzzy_matching_allowed",
        "manual_mapping_required_when_unresolved"
      ],
      "properties": {
        "policy_id": {"const": "private_report_exact_identity_two_route_v1"},
        "filename_route": {"const": "unique_normalized_source_patient_substring"},
        "body_fallback_route": {"const": "unique_normalized_name_field_substring"},
        "fuzzy_matching_allowed": {"const": false},
        "manual_mapping_required_when_unresolved": {"const": true}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "document_ref",
        "authorship",
        "container_audit",
        "association",
        "deidentification"
      ],
      "properties": {
        "report_id": {"type": "string", "pattern": "^EVISOZ-PRPT-[0-9a-f]{24}$"},
        "document_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "authorship": {"const": "physician_authored"},
        "container_audit": {"type": "object"},
        "association": {"$ref": "#/$defs/association"},
        "deidentification": {"$ref": "#/$defs/deidentification"}
      }
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "linkage_group_id",
        "source_patient_sha256",
        "split_assignment"
      ],
      "properties": {
        "status": {"enum": ["linked_high_confidence", "unresolved"]},
        "basis": {
          "enum": [
            "source_filename_unique_patient_substring",
            "physician_report_name_field_unique_patient_substring",
            "none"
          ]
        },
        "linkage_group_id": {"type": ["string", "null"]},
        "source_patient_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "split_assignment": {"type": ["object", "null"]}
      }
    },
    "deidentification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_contains_phi",
        "deidentified_text_released",
        "status",
        "eligible_for_qwen_training",
        "eligible_for_language_evaluation"
      ],
      "properties": {
        "source_contains_phi": {"const": true},
        "deidentified_text_released": {"const": false},
        "status": {"const": "pending_manual_review"},
        "eligible_for_qwen_training": {"const": false},
        "eligible_for_language_evaluation": {"const": false}
      }
    }
  }
}
