{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_candidate_exposure_ledger_v1.schema.json",
  "title": "EviSOZ offline candidate exposure ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "status", "candidate_materialization_ref", "components", "events", "counts", "permissions", "missing_closure_codes", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_candidate_exposure_ledger_v1"},
    "ledger_id": {"type": "string", "pattern": "^EVISOZ-EXPOSURE-[0-9a-f]{24}$"},
    "status": {"const": "deterministic_candidate_lineage_closed_teachers_absent"},
    "candidate_materialization_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "components": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/component"}},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "candidate_count", "development_event_count", "locked_event_count", "outer_fold_event_counts"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "development_event_count": {"type": "integer", "minimum": 0},
        "locked_event_count": {"type": "integer", "minimum": 0},
        "outer_fold_event_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teacher_runtime_required_at_deployment", "candidate_soft_auxiliary_only", "node_localization_supervision_authorized", "calibration_authorized", "training_authorized", "raw_patient_identifiers_stored"],
      "properties": {
        "teacher_runtime_required_at_deployment": {"const": false},
        "candidate_soft_auxiliary_only": {"const": true},
        "node_localization_supervision_authorized": {"const": false},
        "calibration_authorized": {"const": false},
        "training_authorized": {"const": false},
        "raw_patient_identifiers_stored": {"const": false}
      }
    },
    "missing_closure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_role", "status", "target_relation", "exposure_relation", "calibration_state", "node_localization_supervision"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component_role": {"enum": ["deterministic", "teacher_programmatic"]},
        "status": {"enum": ["materialized", "absent"]},
        "target_relation": {"type": "string", "minLength": 1},
        "exposure_relation": {"type": "string", "minLength": 1},
        "calibration_state": {"type": "string", "minLength": 1},
        "node_localization_supervision": {"const": false}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "linkage_group_id", "evisoz_role", "outer_holdout_fold", "candidate_count", "candidate_cache_ref", "source_dual_montage_cache_ref"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "linkage_group_id": {"type": "string", "minLength": 1},
        "evisoz_role": {"enum": ["development_cv", "locked_test"]},
        "outer_holdout_fold": {"type": ["integer", "null"], "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidate_cache_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "source_dual_montage_cache_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"}
      }
    }
  }
}
