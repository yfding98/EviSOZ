{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_qwen_patient_input_v1.schema.json",
  "title": "EviSOZ patient-level candidate-only Qwen input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "input_id", "linkage_group_id", "stage0_status",
    "status", "mode", "source_graph_ref", "source_report_ref",
    "knowledge_selection_ref", "prompt", "evidence_token_contract",
    "permissions", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_qwen_patient_input_v1"},
    "input_id": {"type": "string", "pattern": "^EVISOZ-QPATIENT-[0-9a-f]{24}$"},
    "linkage_group_id": {"type": "string", "pattern": "^EVISOZ-PAT-[0-9a-f]{24}$"},
    "stage0_status": {"const": "NO_GO"},
    "status": {"const": "shadow_input_no_generation"},
    "mode": {"const": "patient_candidate_lexicalization_shadow"},
    "source_graph_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "source_report_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "knowledge_selection_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_policy", "task", "knowledge_context", "claim_graph", "canonical_report"
      ],
      "properties": {
        "system_policy": {"type": "string", "minLength": 1},
        "task": {"const": "lexicalize_candidate_only"},
        "knowledge_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "knowledge_version", "bundle_sha256", "card_ids",
            "card_text_included", "patient_fact_creation_allowed"
          ],
          "properties": {
            "knowledge_version": {"type": "string", "minLength": 1},
            "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "card_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "card_text_included": {"const": false},
            "patient_fact_creation_allowed": {"const": false}
          }
        },
        "claim_graph": {"type": "object"},
        "canonical_report": {"type": "object"}
      }
    },
    "evidence_token_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "token_count", "hidden_size", "embeddings_included",
        "requires_runtime_resampler"
      ],
      "properties": {
        "source": {"const": "runtime_evidence_token_resampler"},
        "token_count": {"const": 32},
        "hidden_size": {"const": 5120},
        "embeddings_included": {"const": false},
        "requires_runtime_resampler": {"const": true}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qwen_generation_allowed", "qwen_may_add_patient_facts",
        "qwen_may_change_localization", "qwen_may_change_uncertainty",
        "knowledge_may_create_patient_facts", "raw_eeg_included",
        "physician_text_included", "requires_physician_review",
        "qwen_may_change_patient_aggregation"
      ],
      "properties": {
        "qwen_generation_allowed": {"const": false},
        "qwen_may_add_patient_facts": {"const": false},
        "qwen_may_change_localization": {"const": false},
        "qwen_may_change_uncertainty": {"const": false},
        "knowledge_may_create_patient_facts": {"const": false},
        "raw_eeg_included": {"const": false},
        "physician_text_included": {"const": false},
        "requires_physician_review": {"const": true},
        "qwen_may_change_patient_aggregation": {"const": false}
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
