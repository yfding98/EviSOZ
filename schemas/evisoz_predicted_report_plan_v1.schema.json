{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_predicted_report_plan_v1.schema.json",
  "title": "EviSOZ deterministic model-candidate report plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "event_id", "source_packet", "stage0_status", "status", "sections", "claims", "permissions", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_predicted_report_plan_v1"},
    "plan_id": {"type": "string", "pattern": "^EVISOZ-RPLAN-[0-9a-f]{24}$"},
    "event_id": {"type": "string", "minLength": 1},
    "source_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "receipt_sha256"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^EVISOZ-EVID-[0-9a-f]{24}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "stage0_status": {"enum": ["GO", "NO_GO"]},
    "status": {"const": "model_candidate_shadow"},
    "sections": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "text_zh", "claim_ids", "knowledge_card_ids"],
        "properties": {
          "section_id": {"type": "string", "minLength": 1},
          "text_zh": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "knowledge_card_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "concept", "support_units", "confidence", "assertion_level", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "concept": {"enum": ["onset_candidate_node", "spread_candidate_edge", "motif_candidate"]},
          "support_units": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "motif": {"type": "integer", "minimum": 0, "maximum": 8},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "assertion_level": {"const": "model_candidate"},
          "status": {"const": "candidate_only"}
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_create_patient_fact", "can_supervise_node_localization", "knowledge_can_create_patient_fact", "qwen_may_lexicalize_only", "requires_physician_review"],
      "properties": {
        "can_create_patient_fact": {"const": false},
        "can_supervise_node_localization": {"const": false},
        "knowledge_can_create_patient_fact": {"const": false},
        "qwen_may_lexicalize_only": {"const": true},
        "requires_physician_review": {"const": true}
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
