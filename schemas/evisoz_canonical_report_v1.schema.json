{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_canonical_report_v1.schema.json",
  "title": "EviSOZ deterministic canonical shadow report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "linkage_group_id", "report_scope", "status", "source_graph_ref", "knowledge_selection_ref", "sections", "safety", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_canonical_report_v1"},
    "report_id": {"type": "string", "pattern": "^EVISOZ-REPORT-[0-9a-f]{24}$"},
    "linkage_group_id": {"type": "string", "pattern": "^EVISOZ-PAT-[0-9a-f]{24}$"},
    "report_scope": {"const": "signal_candidate_shadow"},
    "status": {"const": "research_shadow_not_clinical"},
    "source_graph_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "knowledge_selection_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "sections": {"type": "array", "minItems": 6},
    "safety": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
