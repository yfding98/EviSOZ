{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/clinical_eeg_findings_v1_core_release_profile.schema.json",
  "title": "Clinical EEG Findings v1-core release profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_status",
    "source_contracts",
    "surface_contracts",
    "partition_policy",
    "required_query_gap_specs",
    "qualification_boundary",
    "source_firewall",
    "profile_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "clinical_eeg_findings_v1_core_release_profile_v1"
    },
    "profile_id": {"$ref": "#/$defs/id"},
    "profile_status": {"const": "frozen_public_synthetic_shadow"},
    "source_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_roster_policy_id",
        "atom_roster_policy_sha256",
        "term_query_policy_id",
        "term_query_policy_sha256"
      ],
      "properties": {
        "atom_roster_policy_id": {"$ref": "#/$defs/id"},
        "atom_roster_policy_sha256": {"$ref": "#/$defs/sha256"},
        "term_query_policy_id": {"$ref": "#/$defs/id"},
        "term_query_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "surface_contracts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id",
          "contract_id",
          "contract_sha256",
          "expected_slot_or_query_count",
          "current_status",
          "closes_atomic_query_gaps"
        ],
        "properties": {
          "surface_id": {
            "enum": [
              "event_card_12_slot",
              "record_context_card_6_slot",
              "record_event_aggregate"
            ]
          },
          "contract_id": {"$ref": "#/$defs/id"},
          "contract_sha256": {"$ref": "#/$defs/sha256"},
          "expected_slot_or_query_count": {"type": "integer", "minimum": 1},
          "current_status": {"const": "implemented_structural_shadow"},
          "closes_atomic_query_gaps": {"const": false}
        }
      }
    },
    "partition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_core_atom_count",
        "expected_child_roster_count",
        "expected_term_query_count",
        "atom_roster_partitions",
        "term_query_partitions"
      ],
      "properties": {
        "expected_core_atom_count": {"const": 28},
        "expected_child_roster_count": {"const": 12},
        "expected_term_query_count": {"const": 41},
        "atom_roster_partitions": {"$ref": "#/$defs/partition"},
        "term_query_partitions": {"$ref": "#/$defs/partition"}
      }
    },
    "required_query_gap_specs": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term_query_id",
          "evidence_object",
          "blocking_closure_layers",
          "existing_component_evidence",
          "positive_qualification_disposition"
        ],
        "properties": {
          "term_query_id": {"$ref": "#/$defs/id"},
          "evidence_object": {"$ref": "#/$defs/id"},
          "blocking_closure_layers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "proposal",
                "deterministic_measurement",
                "rule_composer"
              ]
            }
          },
          "existing_component_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "positive_qualification_disposition": {
            "const": "deferred_fail_closed_no_report_allowlist"
          }
        }
      }
    },
    "qualification_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_assertion_levels",
        "report_eligible_automated_allowlist",
        "positive_clinical_qualification_enabled",
        "clinical_or_acquisition_deferred_term_ids",
        "absence_policy",
        "semantic_permissions"
      ],
      "properties": {
        "effective_assertion_levels": {
          "const": ["measured", "model_candidate"]
        },
        "report_eligible_automated_allowlist": {
          "type": "array",
          "maxItems": 0
        },
        "positive_clinical_qualification_enabled": {"const": false},
        "clinical_or_acquisition_deferred_term_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "absence_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_authorizes_clinical_absence",
            "complete_opportunity_required",
            "completed_processing_required",
            "matching_target_domain_sensitivity_or_npv_required",
            "explicit_term_decision_required",
            "not_evaluable_is_negative",
            "technical_failure_is_negative",
            "missing_candidate_is_negative"
          ],
          "properties": {
            "profile_authorizes_clinical_absence": {"const": false},
            "complete_opportunity_required": {"const": true},
            "completed_processing_required": {"const": true},
            "matching_target_domain_sensitivity_or_npv_required": {"const": true},
            "explicit_term_decision_required": {"const": true},
            "not_evaluable_is_negative": {"const": false},
            "technical_failure_is_negative": {"const": false},
            "missing_candidate_is_negative": {"const": false}
          }
        },
        "semantic_permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eeg_signal_measurement_authorized",
            "scalp_visible_onset_candidate_authorized",
            "offline_context_may_create_positive_onset",
            "late_spread_may_create_positive_onset",
            "tcp_edge_may_be_attributed_to_an_endpoint",
            "cortical_soz_or_ez_claim_authorized",
            "report_text_authorized"
          ],
          "properties": {
            "eeg_signal_measurement_authorized": {"const": true},
            "scalp_visible_onset_candidate_authorized": {"const": true},
            "offline_context_may_create_positive_onset": {"const": false},
            "late_spread_may_create_positive_onset": {"const": false},
            "tcp_edge_may_be_attributed_to_an_endpoint": {"const": false},
            "cortical_soz_or_ez_claim_authorized": {"const": false},
            "report_text_authorized": {"const": false}
          }
        }
      }
    },
    "source_firewall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eeg_samples_used",
        "edf_annotations_used",
        "spreadsheet_used",
        "doctor_labels_used",
        "clinical_text_used",
        "patient_metadata_used",
        "video_or_behavior_used",
        "sleep_staging_used",
        "provocation_used",
        "ecg_emg_eog_used",
        "knowledge_base_used_as_patient_fact",
        "llm_used",
        "production_report_route_used"
      ],
      "properties": {
        "eeg_samples_used": {"const": true},
        "edf_annotations_used": {"const": false},
        "spreadsheet_used": {"const": false},
        "doctor_labels_used": {"const": false},
        "clinical_text_used": {"const": false},
        "patient_metadata_used": {"const": false},
        "video_or_behavior_used": {"const": false},
        "sleep_staging_used": {"const": false},
        "provocation_used": {"const": false},
        "ecg_emg_eog_used": {"const": false},
        "knowledge_base_used_as_patient_fact": {"const": false},
        "llm_used": {"const": false},
        "production_report_route_used": {"const": false}
      }
    },
    "profile_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented_now", "required_gap", "deferred_term"],
      "properties": {
        "implemented_now": {"$ref": "#/$defs/idArray"},
        "required_gap": {"$ref": "#/$defs/idArray"},
        "deferred_term": {"$ref": "#/$defs/idArray"}
      }
    }
  }
}
