          }
        },
        "source_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourcePath"
          }
        },
        "expected_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "accounted_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "unit_dispositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unitDisposition"
          }
        },
        "enumeration_scope_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/closedInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childInstance"
          }
        },
        "deduplication_policy_id": {
