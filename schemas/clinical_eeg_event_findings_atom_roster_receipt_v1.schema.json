            "$ref": "#/$defs/id"
          }
        },
        "time_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/closedInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourcePath"
          }
        },
        "waveform_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "pattern_candidate_disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/patternCandidateDisposition"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance_binding_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "childRoster": {
      "type": "object",
      "required": [
        "child_roster_id",
        "group",
        "activation_status",
        "finding_status",
        "processing_disposition",
        "assertion_level",
        "finding_ids",
        "evaluation_opportunity_ids",
        "capability_receipt_ids",
        "sensitivity_receipt_ids",
        "term_decision_receipt_ids",
        "source_paths",
        "expected_unit_ids",
        "accounted_unit_ids",
        "unit_dispositions",
        "enumeration_scope_interval",
        "instances",
        "deduplication_policy_id",
        "deduplication_sha256",
        "completeness_disposition",
        "reason_codes",
        "accounted_for",
        "expert_correctness_claimed",
        "roster_binding_sha256"
      ],
      "properties": {
        "child_roster_id": {
          "$ref": "#/$defs/id"
        },
        "group": {
          "$ref": "#/$defs/group"
        },
        "activation_status": {
          "$ref": "#/$defs/activationStatus"
        },
        "finding_status": {
          "$ref": "#/$defs/status"
        },
        "processing_disposition": {
          "enum": [
            "completed",
            "technical_failure"
          ]
        },
        "assertion_level": {
          "$ref": "#/$defs/assertionLevelOrNull"
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evaluation_opportunity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "capability_receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "sensitivity_receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "term_decision_receipt_ids": {
          "type": "array",
