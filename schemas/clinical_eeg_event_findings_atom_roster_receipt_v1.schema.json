            }
          ]
        },
        "completeness_disposition": {
          "enum": [
            "closed_present_roster",
            "closed_absent_with_opportunity",
            "candidate_roster_uncertain",
            "not_evaluable"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "accounted_for": {
