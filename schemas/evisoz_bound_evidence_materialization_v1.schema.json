{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_bound_evidence_materialization_v1.schema.json",
  "title": "EviSOZ Stage-0 bound evidence materialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "materialization_id", "status", "source_refs", "rows", "counts", "permissions", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_bound_evidence_materialization_v1"},
    "materialization_id": {"type": "string", "pattern": "^EVISOZ-BOUNDEVID-[0-9a-f]{24}$"},
    "status": {"const": "stage0_shadow_bound_examples_materialized"},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_examples_manifest", "findings_claim_report_manifest"],
      "properties": {
        "private_examples_manifest": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "findings_claim_report_manifest": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "physician_report_release": {"anyOf": [{"$ref": "evisoz_artifact_ref_v1.schema.json"}, {"type": "null"}]}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "linkage_group_id", "evisoz_role", "outer_holdout_fold", "bound_evidence_ref", "relative_path"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "linkage_group_id": {"type": "string", "minLength": 1},
          "evisoz_role": {"enum": ["development_cv", "locked_test"]},
          "outer_holdout_fold": {"type": ["integer", "null"], "minimum": 0},
          "bound_evidence_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
          "relative_path": {"type": "string", "pattern": "^events/[A-Za-z0-9._:-]+/bound_evidence\\.json$"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "development_event_count", "locked_test_event_count", "training_authorized_event_count", "physician_report_text_released_count"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "development_event_count": {"type": "integer", "minimum": 0},
        "locked_test_event_count": {"type": "integer", "minimum": 0},
        "training_authorized_event_count": {"const": 0},
        "physician_report_text_released_count": {"type": "integer", "minimum": 0}
      }
    },
    "permissions": {
      "const": {
        "training_allowed": false,
        "node_localization_supervision_allowed": false,
        "report_text_loss_allowed": false,
        "prompt_or_rag_allowed": false,
        "knowledge_can_create_patient_fact": false,
        "generated_text_can_create_patient_fact": false
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
