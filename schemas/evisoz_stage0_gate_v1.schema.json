{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_stage0_gate_v1.schema.json",
  "title": "Aggregate EviSOZ Stage-0 gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "status",
    "checks",
    "blocking_check_ids",
    "prohibited_actions",
    "authorized_next_actions",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_stage0_gate_v1"},
    "gate_id": {"type": "string", "pattern": "^EVISOZ-STAGE0-[0-9a-f]{24}$"},
    "status": {"enum": ["GO", "NO_GO"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "blocking_check_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "prohibited_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authorized_next_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "evidence_ref", "facts", "blocker_codes"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["GO", "QUALIFIED_GO", "EVALUATOR_ONLY_GO", "PARTIAL", "NO_GO"]
        },
        "evidence_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "evisoz_artifact_ref_v1.schema.json"}
          ]
        },
        "facts": {"type": "object"},
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
