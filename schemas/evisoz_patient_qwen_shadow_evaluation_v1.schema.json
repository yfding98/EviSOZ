{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_patient_qwen_shadow_evaluation_v1.schema.json",
  "title": "EviSOZ patient-level Qwen structural shadow evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "status", "source", "counts", "metrics", "runtime_policy", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_patient_qwen_shadow_evaluation_v1"},
    "evaluation_id": {"type": "string", "pattern": "^EVISOZ-PATIENT-QWEN-EVAL-[0-9a-f]{24}$"},
    "status": {"const": "patient_structural_shadow_only"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_ids", "linkage_group_ids", "loader_receipt_sha256"],
      "properties": {
        "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "linkage_group_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EVISOZ-PAT-[0-9a-f]{24}$"}},
        "loader_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "patient_count", "packet_count"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "patient_count": {"type": "integer", "minimum": 1},
        "packet_count": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_replay_rate", "canonical_report_replay_rate", "knowledge_selection_replay_rate", "packet_replay_rate"],
      "properties": {
        "graph_replay_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "canonical_report_replay_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "knowledge_selection_replay_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "packet_replay_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "runtime_policy": {
      "const": {
        "clinical_labels_opened": false,
        "physician_report_text_opened": false,
        "teacher_runtime_opened": false,
        "clinical_soz_metric_computed": false,
        "patient_fact_created": false,
        "candidate_only": true
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
