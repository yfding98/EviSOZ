{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_bound_evidence_shadow_evaluation_v1.schema.json",
  "title": "EviSOZ bound-evidence structural shadow evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "status", "source", "counts", "metrics", "runtime_policy", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_bound_evidence_shadow_evaluation_v1"},
    "evaluation_id": {"type": "string", "pattern": "^EVISOZ-SHADOW-EVAL-[0-9a-f]{24}$"},
    "status": {"const": "structural_shadow_only"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_ids", "loader_receipt_sha256"],
      "properties": {
        "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "loader_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "packet_count", "report_plan_count"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "packet_count": {"type": "integer", "minimum": 1},
        "report_plan_count": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mask_consistency_rate", "report_plan_linkage_rate", "claim_support_unit_validity_rate"],
      "properties": {
        "mask_consistency_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "report_plan_linkage_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "claim_support_unit_validity_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "runtime_policy": {
      "const": {
        "clinical_labels_opened": false,
        "physician_report_text_opened": false,
        "teacher_runtime_opened": false,
        "clinical_soz_metric_computed": false,
        "patient_fact_created": false,
        "candidate_only": true
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
