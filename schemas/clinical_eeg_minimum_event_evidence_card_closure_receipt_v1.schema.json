{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/clinical_eeg_minimum_event_evidence_card_closure_receipt_v1.schema.json",
  "title": "Minimum Event Evidence Card twelve-slot closure receipt v1",
  "description": "Replayable candidate-blind proof that the twelve-slot registry partitions every frozen roster item and operational query exactly once while preserving source implementation and no-promotion states.",
  "type": "object",
  "required": [
    "schema_version",
    "method_id",
    "registry_id",
    "registry_sha256",
    "source_contracts",
    "source_firewall",
    "candidate_blind_denominator",
    "slots",
    "summary",
    "authorization",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "clinical_eeg_minimum_event_evidence_card_closure_receipt_v1"
    },
    "method_id": {
      "const": "CANDIDATE-BLIND-MINIMUM-EVENT-EVIDENCE-CARD-CLOSURE-V1"
    },
    "registry_id": {
      "const": "CLINICAL-EEG-MINIMUM-EVENT-EVIDENCE-CARD-REGISTRY-V1"
    },
    "registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_contracts": {
      "$ref": "#/$defs/sourceContracts"
    },
    "source_firewall": {
      "$ref": "#/$defs/sourceFirewall"
    },
    "candidate_blind_denominator": {
      "const": true
    },
    "slots": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/slotClosure"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceContracts": {
      "type": "object",
      "required": [
        "atom_roster_id",
        "atom_roster_policy_sha256",
        "item_denominator_policy_id",
        "item_denominator_policy_sha256",
        "term_query_denominator_policy_id",
        "term_query_denominator_policy_sha256"
      ],
      "properties": {
        "atom_roster_id": {"const": "CLINICAL-EEG-EVENT-FINDINGS-ATOM-ROSTER-V1"},
        "atom_roster_policy_sha256": {"$ref": "#/$defs/sha256"},
        "item_denominator_policy_id": {"const": "CLINICAL-EEG-EVENT-FINDINGS-DENOMINATOR-POLICY-V1"},
        "item_denominator_policy_sha256": {"$ref": "#/$defs/sha256"},
        "term_query_denominator_policy_id": {"const": "CLINICAL-EEG-EVENT-FINDINGS-TERM-QUERY-DENOMINATOR-POLICY-V2"},
        "term_query_denominator_policy_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sourceFirewall": {
      "type": "object",
      "required": [
        "private_data_used",
        "event_findings_payload_used",
        "findings_candidates_used",
        "payload_evaluation_opportunities_used",
        "event_outcome_used",
        "scalp_onset_hypothesis_used",
        "edf_annotations_used",
        "spreadsheet_used",
        "doctor_labels_used",
        "clinical_text_used",
        "qwen_used"
      ],
      "properties": {
        "private_data_used": {"const": false},
        "event_findings_payload_used": {"const": false},
        "findings_candidates_used": {"const": false},
        "payload_evaluation_opportunities_used": {"const": false},
        "event_outcome_used": {"const": false},
        "scalp_onset_hypothesis_used": {"const": false},
        "edf_annotations_used": {"const": false},
        "spreadsheet_used": {"const": false},
        "doctor_labels_used": {"const": false},
        "clinical_text_used": {"const": false},
        "qwen_used": {"const": false}
      },
      "additionalProperties": false
    },
    "slotClosure": {
      "type": "object",
      "required": [
        "slot_index",
        "slot_id",
        "roster_items",
        "operational_queries"
      ],
      "properties": {
        "slot_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "slot_id": {
          "$ref": "#/$defs/id"
        },
        "roster_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rosterItem"
          }
        },
        "operational_queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operationalQuery"
          }
        }
      },
      "additionalProperties": false
    },
    "rosterItem": {
      "type": "object",
      "required": [
        "roster_item_kind",
        "roster_item_id",
        "source_group",
        "source_implementation_status"
      ],
      "properties": {
        "roster_item_kind": {
          "enum": ["core_atom", "child_roster"]
        },
        "roster_item_id": {
          "$ref": "#/$defs/id"
        },
        "source_group": {
          "enum": [
            "Q_evaluability",
            "C1_phenomenology",
            "C2_spatiotemporal_onset",
            "C3_course"
          ]
        },
        "source_implementation_status": {
          "enum": [
            "implemented_measurement",
            "implemented_candidate",
            "implemented_structural",
            "unimplemented_not_evaluable"
          ]
        }
      },
      "additionalProperties": false
    },
    "operationalQuery": {
      "type": "object",
      "required": [
        "term_query_id",
        "primary_roster_item_kind",
        "primary_roster_item_id",
        "source_implementation_status",
        "source_report_promotion_authorized"
      ],
      "properties": {
        "term_query_id": {
          "$ref": "#/$defs/id"
        },
        "primary_roster_item_kind": {
          "enum": ["core_atom", "child_roster"]
        },
        "primary_roster_item_id": {
          "$ref": "#/$defs/id"
        },
        "source_implementation_status": {
          "enum": [
            "implemented_measurement_shadow",
            "implemented_candidate_shadow",
            "implemented_structural_shadow",
            "unimplemented_not_evaluable"
          ]
        },
        "source_report_promotion_authorized": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "slot_count",
        "core_atom_count",
        "child_roster_count",
        "roster_item_count",
        "operational_query_count",
        "retained_unimplemented_roster_item_count",
        "retained_not_evaluable_query_count",
        "report_promoted_query_count",
        "all_source_roster_items_mapped_exactly_once",
        "all_source_queries_mapped_exactly_once",
        "all_queries_share_slot_with_primary_roster_item",
        "unimplemented_or_not_evaluable_items_retained",
        "source_statuses_preserved"
      ],
      "properties": {
        "slot_count": {"const": 12},
        "core_atom_count": {"const": 28},
        "child_roster_count": {"const": 12},
        "roster_item_count": {"const": 40},
        "operational_query_count": {"const": 41},
        "retained_unimplemented_roster_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "retained_not_evaluable_query_count": {
          "type": "integer",
          "minimum": 0
        },
        "report_promoted_query_count": {"const": 0},
        "all_source_roster_items_mapped_exactly_once": {"const": true},
        "all_source_queries_mapped_exactly_once": {"const": true},
        "all_queries_share_slot_with_primary_roster_item": {"const": true},
        "unimplemented_or_not_evaluable_items_retained": {"const": true},
        "source_statuses_preserved": {"const": true}
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "mapping_is_semantic_partition_only",
        "status_or_assertion_mutation_authorized",
        "clinical_absence_authorized",
        "report_promotion_authorized",
        "clinical_correctness_claimed",
        "soz_or_ez_claim_authorized"
      ],
      "properties": {
        "mapping_is_semantic_partition_only": {"const": true},
        "status_or_assertion_mutation_authorized": {"const": false},
        "clinical_absence_authorized": {"const": false},
        "report_promotion_authorized": {"const": false},
        "clinical_correctness_claimed": {"const": false},
        "soz_or_ez_claim_authorized": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
