{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_public_auxiliary_exposure_projection_v1.schema.json",
  "title": "Privacy-safe public auxiliary patient/exposure projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "status",
    "source_registry_ref",
    "linkage_groups",
    "split_roster",
    "patient_exposure_rows",
    "counts",
    "permissions",
    "missing_closure_codes",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_public_auxiliary_exposure_projection_v1"},
    "projection_id": {"type": "string", "pattern": "^EVISOZ-PUBEXP-[0-9a-f]{24}$"},
    "status": {"const": "patient_split_projection_materialized_training_disabled"},
    "source_registry_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "linkage_groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "evisoz_patient_linkage_group_v1.schema.json"}
    },
    "split_roster": {"$ref": "evisoz_split_roster_v1.schema.json"},
    "patient_exposure_rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/exposureRow"}
    },
    "counts": {"type": "object"},
    "permissions": {"$ref": "#/$defs/permissions"},
    "missing_closure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "exposureRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkage_group_id",
        "outer_fold",
        "deepsoz_source_train_overlap",
        "tuev_train_visible_overlap",
        "self_supervised_signal_use_requires_outer_fold_exclusion",
        "task_label_use_authorized"
      ],
      "properties": {
        "linkage_group_id": {"type": "string", "pattern": "^EVISOZ-PAT-[0-9a-f]{24}$"},
        "outer_fold": {"type": "integer", "minimum": 0},
        "deepsoz_source_train_overlap": {"type": "boolean"},
        "tuev_train_visible_overlap": {"type": "boolean"},
        "self_supervised_signal_use_requires_outer_fold_exclusion": {"const": true},
        "task_label_use_authorized": {"const": false}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_authorized_by_projection",
        "task_label_training_authorized",
        "self_supervised_signal_pretraining_authorized",
        "outer_fold_exclusion_required_if_later_authorized",
        "public_v29_to_tusz_crosswalk_closed",
        "tuev_eval_patient_identity_closed",
        "raw_patient_identifiers_stored"
      ],
      "properties": {
        "training_authorized_by_projection": {"const": false},
        "task_label_training_authorized": {"const": false},
        "self_supervised_signal_pretraining_authorized": {"const": false},
        "outer_fold_exclusion_required_if_later_authorized": {"const": true},
        "public_v29_to_tusz_crosswalk_closed": {"const": false},
        "tuev_eval_patient_identity_closed": {"const": false},
        "raw_patient_identifiers_stored": {"const": false}
      }
    }
  }
}
