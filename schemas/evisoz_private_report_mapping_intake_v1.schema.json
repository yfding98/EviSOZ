{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_private_report_mapping_intake_v1.schema.json",
  "title": "EviSOZ private physician report mapping intake v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intake_id", "status", "inventory_ref", "split_roster_ref", "requests", "counts", "permissions", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_private_report_mapping_intake_v1"},
    "intake_id": {"type": "string", "pattern": "^EVISOZ-REPORT-MAP-[0-9a-f]{24}$"},
    "status": {"const": "awaiting_authoritative_mapping"},
    "inventory_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "split_roster_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request"}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_count", "unresolved_count", "resolved_count"],
      "properties": {
        "request_count": {"type": "integer", "minimum": 1},
        "unresolved_count": {"type": "integer", "minimum": 1},
        "resolved_count": {"const": 0}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_authority_required", "training_authorized", "report_text_release_authorized", "raw_patient_identifiers_stored"],
      "properties": {
        "mapping_authority_required": {"const": true},
        "training_authorized": {"const": false},
        "report_text_release_authorized": {"const": false},
        "raw_patient_identifiers_stored": {"const": false}
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "document_ref", "requested_action", "proposed_linkage_group_id", "authority_attestation"],
      "properties": {
        "report_id": {"type": "string", "pattern": "^EVISOZ-PRPT-[0-9a-f]{24}$"},
        "document_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "requested_action": {"const": "provide_authoritative_linkage_or_exclude"},
        "proposed_linkage_group_id": {"type": "null"},
        "authority_attestation": {"type": "null"}
      }
    }
  }
}
