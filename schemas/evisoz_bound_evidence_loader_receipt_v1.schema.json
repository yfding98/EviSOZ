{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_bound_evidence_loader_receipt_v1.schema.json",
  "title": "EviSOZ bound-evidence loader replay receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "loader_id",
    "status",
    "source_refs",
    "selection",
    "counts",
    "runtime_policy",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_bound_evidence_loader_receipt_v1"},
    "loader_id": {"type": "string", "pattern": "^EVISOZ-BOUND-LOADER-[0-9a-f]{24}$"},
    "status": {"const": "real_bound_evidence_replay_only"},
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bound_evidence_manifest"],
      "properties": {
        "bound_evidence_manifest": {"$ref": "evisoz_artifact_ref_v1.schema.json"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evisoz_role", "limit", "event_ids", "linkage_group_ids"],
      "properties": {
        "evisoz_role": {"type": ["string", "null"], "enum": ["development_cv", "locked_test", null]},
        "limit": {"type": ["integer", "null"], "minimum": 1},
        "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "linkage_group_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "patient_count"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "patient_count": {"type": "integer", "minimum": 1}
      }
    },
    "runtime_policy": {
      "const": {
        "physician_report_text_opened": false,
        "canonical_shadow_report_opened": true,
        "teacher_runtime_opened": false,
        "training_allowed": false,
        "prompt_or_rag_allowed": false,
        "node_localization_supervision_allowed": false
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
