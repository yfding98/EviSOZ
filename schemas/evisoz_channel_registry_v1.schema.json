{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_channel_registry_v1.schema.json",
  "title": "EviSOZ Standard19-node and TCP22-edge registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "normalization_policy",
    "node_units",
    "auxiliary_electrodes",
    "tcp22_derivations",
    "tcp22_order_binding",
    "registry_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_channel_registry_v1"},
    "registry_id": {
      "type": "string",
      "pattern": "^EVISOZ-CHANNELS-[0-9a-f]{24}$"
    },
    "normalization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "legacy_aliases",
        "sp1_sp2_preserved_without_forced_mapping",
        "edge_and_node_coordinates_separate"
      ],
      "properties": {
        "policy_id": {"const": "identity_alias_only_no_spatial_substitution_v1"},
        "legacy_aliases": {
          "const": {"T3": "T7", "T4": "T8", "T5": "P7", "T6": "P8"}
        },
        "sp1_sp2_preserved_without_forced_mapping": {"const": true},
        "edge_and_node_coordinates_separate": {"const": true}
      }
    },
    "node_units": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {"$ref": "#/$defs/electrodeUnit"}
    },
    "auxiliary_electrodes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/electrodeUnit"}
    },
    "tcp22_derivations": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {"$ref": "#/$defs/derivation"}
    },
    "tcp22_order_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "ordered_pairs_sha256", "edge_count", "orientation"],
      "properties": {
        "source": {"const": "code/soz_pre/constants.py::TCP_PAIRS"},
        "ordered_pairs_sha256": {"$ref": "#/$defs/sha256"},
        "edge_count": {"const": 22},
        "orientation": {"const": "positive_minus_negative"}
      }
    },
    "registry_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "electrodeUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "channel_type",
        "normalized_name",
        "identity_aliases",
        "standard19_index",
        "v29_candidate"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "channel_type": {"enum": ["electrode_node", "auxiliary_electrode"]},
        "normalized_name": {"type": "string", "minLength": 1},
        "identity_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "standard19_index": {"type": ["integer", "null"], "minimum": 0},
        "v29_candidate": {"type": "boolean"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "normalized"],
      "properties": {
        "original": {"type": "string", "minLength": 1},
        "normalized": {"type": "string", "minLength": 1}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "source_index",
        "channel_original",
        "channel_normalized",
        "channel_type",
        "positive_electrode",
        "negative_electrode",
        "formula",
        "node_projection_authorized"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "source_index": {"type": "integer", "minimum": 0, "maximum": 21},
        "channel_original": {"type": "string", "minLength": 1},
        "channel_normalized": {"type": "string", "minLength": 1},
        "channel_type": {"const": "bipolar_derivation_edge"},
        "positive_electrode": {"$ref": "#/$defs/endpoint"},
        "negative_electrode": {"$ref": "#/$defs/endpoint"},
        "formula": {"const": "positive_minus_negative"},
        "node_projection_authorized": {"const": false}
      }
    }
  }
}
