{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_teacher_candidate_materialization_v1.schema.json",
  "title": "EviSOZ offline teacher candidate materialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "materialization_id", "teacher_id", "status", "source_split_roster_ref", "teacher_model_ref", "events", "counts", "permissions", "missing_closure_codes", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_teacher_candidate_materialization_v1"},
    "materialization_id": {"type": "string", "pattern": "^EVISOZ-TEACHER-MAT-[0-9a-f]{24}$"},
    "teacher_id": {"enum": ["cerebragloss", "elm"]},
    "status": {"const": "complete_development_only_teacher_candidates_uncalibrated"},
    "source_split_roster_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "teacher_model_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "counts": {"$ref": "#/$defs/counts"},
    "permissions": {"$ref": "#/$defs/permissions"},
    "missing_closure_codes": {"const": ["fold_local_calibration_receipts_missing"]},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "linkage_group_id", "outer_holdout_fold", "candidate_count", "relative_cache_path", "candidate_cache_ref"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "linkage_group_id": {"type": "string", "minLength": 1},
        "outer_holdout_fold": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "relative_cache_path": {"type": "string", "pattern": "^events/[^/]+/candidate_cache\\.json$"},
        "candidate_cache_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "candidate_count", "outer_fold_event_counts"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "outer_fold_event_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teacher_runtime_required_at_deployment", "candidate_soft_auxiliary_only", "node_localization_supervision_authorized", "calibration_authorized", "training_authorized", "locked_test_included"],
      "properties": {
        "teacher_runtime_required_at_deployment": {"const": false},
        "candidate_soft_auxiliary_only": {"const": true},
        "node_localization_supervision_authorized": {"const": false},
        "calibration_authorized": {"const": false},
        "training_authorized": {"const": false},
        "locked_test_included": {"const": false}
      }
    }
  }
}
