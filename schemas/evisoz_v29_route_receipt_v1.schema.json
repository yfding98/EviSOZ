{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_v29_route_receipt_v1.schema.json",
  "title": "EviSOZ frozen canonical v29 route receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "method_id",
    "patient_id_sha256",
    "decision",
    "resource_config_ref",
    "resource_registry_projection_sha256",
    "public_roster_binding",
    "safety_contract",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_v29_route_receipt_v1"},
    "receipt_id": {
      "type": "string",
      "pattern": "^EVISOZ-V29-ROUTE-[0-9a-f]{24}$"
    },
    "method_id": {"const": "canonical_v29_equal_H_D_probability_ensemble"},
    "patient_id_sha256": {"$ref": "#/$defs/sha256"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_namespace",
        "identity_sha256",
        "public_roster_relation",
        "public_roster_relation_proof_kind",
        "public_roster_relation_proof_sha256",
        "public_roster_relation_proof_ref",
        "public_roster_relation_sha256",
        "route",
        "unit_kind",
        "fold_indices",
        "public_patient_index",
        "historical_source_role",
        "access_role",
        "historical_development_eligible",
        "route_layer_training_authorized"
      ],
      "properties": {
        "identity_namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "public_roster_relation": {
          "enum": ["frozen_public_roster_member", "proven_absent"]
        },
        "public_roster_relation_proof_kind": {
          "enum": [
            "frozen_public_roster_index",
            "caller_verified_namespace_absence"
          ]
        },
        "public_roster_relation_proof_sha256": {"$ref": "#/$defs/sha256"},
        "public_roster_relation_proof_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "evisoz_artifact_ref_v1.schema.json"}
          ]
        },
        "public_roster_relation_sha256": {"$ref": "#/$defs/sha256"},
        "route": {
          "enum": [
            "historical_public_oof_held_fold",
            "frozen_five_fold_event_mean"
          ]
        },
        "unit_kind": {"enum": ["patient", "event"]},
        "fold_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 4}
        },
        "public_patient_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "historical_source_role": {
          "enum": [null, "source_train", "source_dev", "source_eval"]
        },
        "access_role": {
          "enum": ["development_only", "evaluator_only", "inference_only"]
        },
        "historical_development_eligible": {"type": "boolean"},
        "route_layer_training_authorized": {"const": false}
      }
    },
    "resource_config_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "resource_registry_projection_sha256": {"$ref": "#/$defs/sha256"},
    "public_roster_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_count",
        "patient_order_sha256",
        "roster_projection_sha256",
        "membership_state",
        "member_patient_index",
        "member_held_out_fold"
      ],
      "properties": {
        "patient_count": {"const": 102},
        "patient_order_sha256": {"$ref": "#/$defs/sha256"},
        "roster_projection_sha256": {"$ref": "#/$defs/sha256"},
        "membership_state": {"enum": ["present", "absent"]},
        "member_patient_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "member_held_out_fold": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "safety_contract": {
      "const": {
        "route_layer_is_training_authority": false,
        "historical_source_role_can_enable_loss": false,
        "training_requires_independent_split_and_field_release": true,
        "model_execution_performed": false,
        "typed_patient_identity_required": true,
        "unknown_public_roster_relation_fails_closed": true,
        "non_public_route_requires_proven_absence": true,
        "frozen_public_route_requires_authoritative_membership": true
      }
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "route": {"const": "historical_public_oof_held_fold"}
            },
            "required": ["route"]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "identity_namespace": {
                "const": "deepsoz_tusz_public_v29"
              },
              "public_roster_relation": {
                "const": "frozen_public_roster_member"
              },
              "public_roster_relation_proof_kind": {
                "const": "frozen_public_roster_index"
              },
              "public_roster_relation_proof_ref": {"type": "null"},
              "unit_kind": {"const": "patient"},
              "fold_indices": {"minItems": 1, "maxItems": 1},
              "public_patient_index": {"type": "integer"},
              "historical_source_role": {
                "enum": ["source_train", "source_dev", "source_eval"]
              },
              "access_role": {"enum": ["development_only", "evaluator_only"]}
            }
          },
          "public_roster_binding": {
            "properties": {
              "membership_state": {"const": "present"},
              "member_patient_index": {"type": "integer"},
              "member_held_out_fold": {"type": "integer"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "route": {"const": "frozen_five_fold_event_mean"}
            },
            "required": ["route"]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "identity_namespace": {
                "not": {"const": "deepsoz_tusz_public_v29"}
              },
              "public_roster_relation": {"const": "proven_absent"},
              "public_roster_relation_proof_kind": {
                "const": "caller_verified_namespace_absence"
              },
              "public_roster_relation_proof_ref": {
                "allOf": [
                  {"$ref": "evisoz_artifact_ref_v1.schema.json"},
                  {
                    "type": "object",
                    "properties": {
                      "artifact_kind": {"const": "patient_linkage_group"},
                      "media_type": {"const": "application/json"},
                      "content_hash": {
                        "properties": {
                          "domain": {"const": "canonical_json_v1"}
                        }
                      },
                      "payload_schema_version": {
                        "const": "evisoz_patient_linkage_group_v1"
                      }
                    }
                  }
                ]
              },
              "unit_kind": {"const": "event"},
              "fold_indices": {"const": [0, 1, 2, 3, 4]},
              "public_patient_index": {"type": "null"}
            }
          },
          "public_roster_binding": {
            "properties": {
              "membership_state": {"const": "absent"},
              "member_patient_index": {"type": "null"},
              "member_held_out_fold": {"type": "null"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
