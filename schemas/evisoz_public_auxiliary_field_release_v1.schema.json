{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_public_auxiliary_field_release_v1.schema.json",
  "title": "Capability-only public auxiliary field release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "status", "projection_ref", "datasets", "counts", "permissions", "missing_closure_codes", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "evisoz_public_auxiliary_field_release_v1"},
    "release_id": {"type": "string", "pattern": "^EVISOZ-PUBFIELDS-[0-9a-f]{24}$"},
    "status": {"const": "capability_catalog_materialized_training_disabled"},
    "projection_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "datasets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset"}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_count", "field_count", "patient_count"],
      "properties": {
        "dataset_count": {"const": 1},
        "field_count": {"type": "integer", "minimum": 1},
        "patient_count": {"type": "integer", "minimum": 1}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_values_training_authorized", "report_target_authorized", "self_supervised_signal_use_authorized", "outer_fold_exclusion_required", "knowledge_can_create_patient_fact", "raw_patient_identifiers_stored"],
      "properties": {
        "field_values_training_authorized": {"const": false},
        "report_target_authorized": {"const": false},
        "self_supervised_signal_use_authorized": {"const": false},
        "outer_fold_exclusion_required": {"const": true},
        "knowledge_can_create_patient_fact": {"const": false},
        "raw_patient_identifiers_stored": {"const": false}
      }
    },
    "missing_closure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "lossPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typed_slot_loss", "node_localization_loss", "report_text_loss"],
      "properties": {
        "typed_slot_loss": {"const": false},
        "node_localization_loss": {"const": false},
        "report_text_loss": {"const": false}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "field_path", "semantic_role", "payload_schema_version", "allowed_roles", "loss_allowed", "report_target_allowed", "prompt_or_rag_allowed"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "field_path": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
        "semantic_role": {"enum": ["node_label", "region_label", "laterality_label", "morphology", "spread", "evolution", "quality", "localizability", "text", "knowledge_rule", "other"]},
        "payload_schema_version": {"type": "string", "minLength": 1},
        "allowed_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["development_cv", "locked_test", "external_evaluation"]}},
        "loss_allowed": {"$ref": "#/$defs/lossPermissions"},
        "report_target_allowed": {"const": false},
        "prompt_or_rag_allowed": {"const": false}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "report_scope", "patient_count", "field_roster", "field_values_materialized", "raw_patient_identifiers_stored"],
      "properties": {
        "dataset_id": {"const": "tusz"},
        "report_scope": {"const": "ictal_findings"},
        "patient_count": {"type": "integer", "minimum": 1},
        "field_roster": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
        "field_values_materialized": {"const": false},
        "raw_patient_identifiers_stored": {"const": false}
      }
    }
  }
}
