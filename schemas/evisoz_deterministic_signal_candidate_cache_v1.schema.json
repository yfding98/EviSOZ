{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_deterministic_signal_candidate_cache_v1.schema.json",
  "title": "EviSOZ deterministic real-signal candidate cache v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cache_id",
    "status",
    "event_identity_ref",
    "dual_montage_cache_ref",
    "montage_receipt_ref",
    "feature_spec",
    "feature_spec_ref",
    "unit_feature_rows",
    "global_feature_rows",
    "candidate_rows",
    "authority_policy",
    "counts",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_deterministic_signal_candidate_cache_v1"},
    "cache_id": {"type": "string", "pattern": "^EVISOZ-SIGCAND-[0-9a-f]{24}$"},
    "status": {"const": "complete_uncalibrated_soft_auxiliary_only"},
    "event_identity_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "dual_montage_cache_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "montage_receipt_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "feature_spec": {"$ref": "#/$defs/featureSpec"},
    "feature_spec_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "unit_feature_rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unitFeatureRow"}
    },
    "global_feature_rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/globalFeatureRow"}
    },
    "candidate_rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidateRow"}
    },
    "authority_policy": {"$ref": "#/$defs/authorityPolicy"},
    "counts": {"$ref": "#/$defs/counts"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finiteNumber": {"type": "number"},
    "nullableFiniteNumber": {"type": ["number", "null"]},
    "interval": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "low_hz", "high_hz"],
      "properties": {
        "name": {"enum": ["delta", "theta", "alpha", "beta", "gamma"]},
        "low_hz": {"type": "number", "minimum": 0},
        "high_hz": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "featureSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version",
        "sampling_rate_hz",
        "context_interval_seconds",
        "onset_interval_seconds",
        "baseline_interval_seconds",
        "early_interval_seconds",
        "evolution_patch_seconds",
        "evolution_hop_seconds",
        "spectral_range_hz",
        "bands",
        "ratio_epsilon_policy",
        "stable_change_rule",
        "candidate_rules",
        "quantization_significant_digits"
      ],
      "properties": {
        "spec_version": {"const": "evisoz_deterministic_signal_features_v1"},
        "sampling_rate_hz": {"const": 200},
        "context_interval_seconds": {"$ref": "#/$defs/interval"},
        "onset_interval_seconds": {"$ref": "#/$defs/interval"},
        "baseline_interval_seconds": {"$ref": "#/$defs/interval"},
        "early_interval_seconds": {"$ref": "#/$defs/interval"},
        "evolution_patch_seconds": {"type": "number", "exclusiveMinimum": 0},
        "evolution_hop_seconds": {"type": "number", "exclusiveMinimum": 0},
        "spectral_range_hz": {"$ref": "#/$defs/interval"},
        "bands": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/band"}
        },
        "ratio_epsilon_policy": {"const": "max_denominator_times_1e-6_or_1e-18"},
        "stable_change_rule": {"const": "two_consecutive_one_second_patches_with_max_abs_log2_ratio_at_least_1"},
        "candidate_rules": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "quantization_significant_digits": {"const": 10}
      }
    },
    "bandMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta", "theta", "alpha", "beta", "gamma"],
      "properties": {
        "delta": {"$ref": "#/$defs/finiteNumber"},
        "theta": {"$ref": "#/$defs/finiteNumber"},
        "alpha": {"$ref": "#/$defs/finiteNumber"},
        "beta": {"$ref": "#/$defs/finiteNumber"},
        "gamma": {"$ref": "#/$defs/finiteNumber"}
      }
    },
    "windowFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rms",
        "median_absolute_amplitude",
        "line_length_per_sample",
        "dominant_frequency_hz",
        "spectral_entropy",
        "rhythmicity",
        "absolute_band_power",
        "relative_band_power"
      ],
      "properties": {
        "rms": {"$ref": "#/$defs/finiteNumber"},
        "median_absolute_amplitude": {"$ref": "#/$defs/finiteNumber"},
        "line_length_per_sample": {"$ref": "#/$defs/finiteNumber"},
        "dominant_frequency_hz": {"$ref": "#/$defs/finiteNumber"},
        "spectral_entropy": {"$ref": "#/$defs/finiteNumber"},
        "rhythmicity": {"$ref": "#/$defs/finiteNumber"},
        "absolute_band_power": {"$ref": "#/$defs/bandMap"},
        "relative_band_power": {"$ref": "#/$defs/bandMap"}
      }
    },
    "changeFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rms_ratio",
        "median_absolute_amplitude_ratio",
        "line_length_ratio",
        "band_power_ratios",
        "dominant_frequency_delta_hz",
        "frequency_slope_hz_per_second",
        "frequency_range_hz",
        "envelope_slope_per_second",
        "first_stable_change_seconds"
      ],
      "properties": {
        "rms_ratio": {"$ref": "#/$defs/finiteNumber"},
        "median_absolute_amplitude_ratio": {"$ref": "#/$defs/finiteNumber"},
        "line_length_ratio": {"$ref": "#/$defs/finiteNumber"},
        "band_power_ratios": {"$ref": "#/$defs/bandMap"},
        "dominant_frequency_delta_hz": {"$ref": "#/$defs/finiteNumber"},
        "frequency_slope_hz_per_second": {"$ref": "#/$defs/finiteNumber"},
        "frequency_range_hz": {"$ref": "#/$defs/finiteNumber"},
        "envelope_slope_per_second": {"$ref": "#/$defs/finiteNumber"},
        "first_stable_change_seconds": {"$ref": "#/$defs/nullableFiniteNumber"}
      }
    },
    "unitFeatureRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "unit_index",
        "unit_id",
        "unit_type",
        "observed",
        "baseline",
        "early",
        "change",
        "authority",
        "status"
      ],
      "properties": {
        "view": {"enum": ["car19_context", "tcp22_edge_context"]},
        "unit_index": {"type": "integer", "minimum": 0},
        "unit_id": {"type": "string", "minLength": 1},
        "unit_type": {"enum": ["electrode", "bipolar_derivation"]},
        "observed": {"type": "boolean"},
        "baseline": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/windowFeatures"}]},
        "early": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/windowFeatures"}]},
        "change": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/changeFeatures"}]},
        "authority": {"const": "signal_derived"},
        "status": {"const": "derived_candidate"}
      }
    },
    "globalFeatureRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "value", "support_units", "authority", "status"],
      "properties": {
        "feature_id": {"enum": ["left_right_synchrony", "spatial_entropy"]},
        "value": {"$ref": "#/$defs/finiteNumber"},
        "support_units": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority": {"const": "signal_derived"},
        "status": {"const": "derived_candidate"}
      }
    },
    "candidateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "concept",
        "support_view",
        "support_units",
        "support_interval_seconds",
        "heuristic_score",
        "rule_id",
        "shared_electrode",
        "authority",
        "status",
        "calibration_state",
        "permitted_uses",
        "prohibited_uses"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^EVISOZ-CAND-[0-9a-f]{24}$"},
        "concept": {
          "enum": [
            "possible_attenuation",
            "possible_LVFA",
            "possible_rhythmic_theta",
            "possible_rhythmic_delta",
            "frequency_evolution_present",
            "near_synchronous_bilateral_change",
            "possible_phase_reversal"
          ]
        },
        "support_view": {"enum": ["car19_context", "tcp22_edge_context"]},
        "support_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "support_interval_seconds": {"$ref": "#/$defs/interval"},
        "heuristic_score": {"type": "number", "minimum": 0, "maximum": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "shared_electrode": {"type": ["string", "null"]},
        "authority": {"const": "signal_derived"},
        "status": {"const": "derived_candidate"},
        "calibration_state": {"const": "uncalibrated"},
        "permitted_uses": {"const": ["soft_auxiliary"]},
        "prohibited_uses": {
          "const": ["clinical_label", "measured_fact", "node_localization_supervision"]
        }
      }
    },
    "authorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "status",
        "calibration_state",
        "soft_auxiliary_only",
        "may_create_clinical_label",
        "may_be_treated_as_measured_fact",
        "may_supervise_node_localization",
        "fold_local_calibration_receipt_present"
      ],
      "properties": {
        "authority": {"const": "signal_derived"},
        "status": {"const": "derived_candidate"},
        "calibration_state": {"const": "uncalibrated"},
        "soft_auxiliary_only": {"const": true},
        "may_create_clinical_label": {"const": false},
        "may_be_treated_as_measured_fact": {"const": false},
        "may_supervise_node_localization": {"const": false},
        "fold_local_calibration_receipt_present": {"const": false}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_feature_row_count", "observed_unit_count", "global_feature_row_count", "candidate_count", "candidate_concept_counts"],
      "properties": {
        "unit_feature_row_count": {"type": "integer", "minimum": 1},
        "observed_unit_count": {"type": "integer", "minimum": 0},
        "global_feature_row_count": {"type": "integer", "minimum": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidate_concept_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
