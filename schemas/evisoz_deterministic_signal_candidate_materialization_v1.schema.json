{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evisoz_deterministic_signal_candidate_materialization_v1.schema.json",
  "title": "EviSOZ deterministic signal candidate materialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "materialization_id",
    "status",
    "source_cohort_ref",
    "feature_spec_ref",
    "events",
    "counts",
    "authority_policy",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "evisoz_deterministic_signal_candidate_materialization_v1"},
    "materialization_id": {"type": "string", "pattern": "^EVISOZ-SIGCANDS-[0-9a-f]{24}$"},
    "status": {"const": "complete_real_signal_deterministic_candidates_uncalibrated"},
    "source_cohort_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "feature_spec_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "counts": {"$ref": "#/$defs/counts"},
    "authority_policy": {"$ref": "#/$defs/authorityPolicy"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "authorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "status",
        "calibration_state",
        "soft_auxiliary_only",
        "may_create_clinical_label",
        "may_be_treated_as_measured_fact",
        "may_supervise_node_localization",
        "fold_local_calibration_receipt_present"
      ],
      "properties": {
        "authority": {"const": "signal_derived"},
        "status": {"const": "derived_candidate"},
        "calibration_state": {"const": "uncalibrated"},
        "soft_auxiliary_only": {"const": true},
        "may_create_clinical_label": {"const": false},
        "may_be_treated_as_measured_fact": {"const": false},
        "may_supervise_node_localization": {"const": false},
        "fold_local_calibration_receipt_present": {"const": false}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "linkage_group_id",
        "evisoz_role",
        "outer_holdout_fold",
        "source_dual_montage_cache_ref",
        "candidate_cache_ref",
        "relative_candidate_cache_path",
        "candidate_count",
        "candidate_concept_counts"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "linkage_group_id": {"type": "string", "pattern": "^EVISOZ-PAT-[0-9a-f]{24}$"},
        "evisoz_role": {"enum": ["development_cv", "locked_test"]},
        "outer_holdout_fold": {"type": ["integer", "null"], "minimum": 0},
        "source_dual_montage_cache_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "candidate_cache_ref": {"$ref": "evisoz_artifact_ref_v1.schema.json"},
        "relative_candidate_cache_path": {"type": "string", "minLength": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidate_concept_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "role_event_counts",
        "unit_feature_row_count",
        "global_feature_row_count",
        "candidate_count",
        "candidate_concept_counts",
        "fold_local_calibration_receipt_count",
        "node_localization_supervision_candidate_count"
      ],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "role_event_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "unit_feature_row_count": {"type": "integer", "minimum": 1},
        "global_feature_row_count": {"type": "integer", "minimum": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidate_concept_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "fold_local_calibration_receipt_count": {"const": 0},
        "node_localization_supervision_candidate_count": {"const": 0}
      }
    }
  }
}
